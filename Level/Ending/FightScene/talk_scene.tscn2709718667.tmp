[node name="StoryLines" type="Node" parent="."]

[node name="DialogueText" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "Kasili lowers its head in shame, ashamed but no longer defiant."
npc_info = ExtResource("3_vbwqs")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText2" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "\"I did not understand the weight of my strength\"  it murmurs"
npc_info = ExtResource("3_vbwqs")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText3" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "Kasili coils back, hissing. 
\"Set it right? You're the one crushing! Get off my current, Agama!\""
npc_info = ExtResource("3_vbwqs")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText4" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "Agama's thunderous voice softens."
npc_info = ExtResource("2_l1eyf")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText5" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "\"Strength without care is what nearly caused the lives of the village below. But shame without change protects no one either.\""
npc_info = ExtResource("2_l1eyf")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText6" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "Kasili raises its head. \"Then let me prove it. I vow to guard these waters, not to master them.\""
npc_info = ExtResource("3_vbwqs")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText7" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "Agama presses a claw to the stone beside Kasili's coils."
npc_info = ExtResource("2_l1eyf")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText8" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "\"And I vow to watch over this mountain always, so its strength serves the village, not threatens it.\""
npc_info = ExtResource("3_vbwqs")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText9" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "The gemstones Agama channeled earlier pulse once, faintly, as if sealing the promise."
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText10" type="Node" parent="StoryLines"]
script = ExtResource("10_xaocr")
text = "Both of them calm down and the ground shaking stop, "
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="Timer" type="Timer" parent="."]
one_shot = true

