[node name="StoryLines" type="Node" parent="."]

[node name="DialogueText" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "\"You reckless creature!\" Agama's voice cracks like thunder. "
voice = ExtResource("11_crwvs")
npc_info = ExtResource("2_xsd23")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText2" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "\"Your thrashing woke the crater. Now hold still while I set this right!\""
voice = ExtResource("12_rqlde")
npc_info = ExtResource("2_xsd23")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText3" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "\"Set it right? You're the one crushing! Get off my current, Agama!\""
voice = ExtResource("13_ytmub")
npc_info = ExtResource("3_ul4ib")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText4" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Agama slams a claw down to pin the eel still. Kasili twists free at the last second and the claw meets stone instead, splitting it clean through."
voice = ExtResource("14_anfcc")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText5" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "\"Stay STILL!\" Agama roars, lunging again."
voice = ExtResource("13_0aekn")
npc_info = ExtResource("2_xsd23")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText6" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Kasili darts sideways, and the two collide in a tangle of scale and shell against the crater wall."
voice = ExtResource("16_p7hmw")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText7" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Neither of them notices the crack spreading beneath them a hairline fracture, widening with every blow, every thrash, every roar."
voice = ExtResource("17_epk6c")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText8" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "\"You're impossible to catch!\" Agama snarls."
voice = ExtResource("14_ytmub")
npc_info = ExtResource("2_xsd23")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText9" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Kasili slips through the gap, laughing despite the danger."
voice = ExtResource("19_lb01i")
npc_info = ExtResource("3_ul4ib")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText10" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "\"Maybe if you asked nicely instead of trying to squash me\" Kasili's taunt cuts short as the ground beneath them both suddenly groans."
voice = ExtResource("16_k0tex")
npc_info = ExtResource("3_ul4ib")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText11" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Too late, they feel it the crater shudders, not from the mountain's own anger, but from the damage they carved into it themselves."
voice = ExtResource("21_tdwk4")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText12" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Agama freezes mid-strike. Kasili stops thrashing."
voice = ExtResource("22_8c1m5")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText13" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "For the first time, both look down, really look at the fractures spreading beneath their feet."
voice = ExtResource("23_peqno")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText14" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "\"...We did this\" Agama says quietly."
voice = ExtResource("24_anfcc")
npc_info = ExtResource("2_xsd23")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText15" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Kasili has no clever answer this time. Only silence, and the low, worsening rumble of a mountain they broke without meaning to."
voice = ExtResource("24_konnx")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText16" type="Node" parent="StoryLines"]
script = ExtResource("8_rqlde")
text = "Down below, the village doesn't care who caused it, it's just the same. The Danger already reached their homes, and in the quiet wake of the storm, only the silence remains."
voice = ExtResource("25_xn1er")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="Timer" type="Timer" parent="."]
one_shot = true

