[node name="DialogueText" type="Node" parent="NPC/DialogueInteraction"]
script = ExtResource("10_cgk7h")
text = "[b]Agama...?[/b] the mountain has been quiet since you took your post. That is good. But quiet does not mean safe"
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText2" type="Node" parent="NPC/DialogueInteraction"]
script = ExtResource("10_cgk7h")
text = "Is that so....Umm is there something going on inside the forest?"
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText3" type="Node" parent="NPC/DialogueInteraction"]
script = ExtResource("10_cgk7h")
text = "Nothing much... But I heared from the people who came in the forest that there's something or someone wandering at the side of the river. [b]Can You Check that?[/]"
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText4" type="Node" parent="NPC/DialogueInteraction"]
script = ExtResource("10_cgk7h")
text = "Sure!"
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

