[node name="DialogueText" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "Kanibag."
npc_info = SubResource("Resource_bh6j7")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText2" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "Agama...ano at napa bisita ka sako?"
voice = ExtResource("25_281ib")
npc_info = SubResource("Resource_4tfbx")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText3" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "Kaipuhan ko ang tabang mo."
npc_info = SubResource("Resource_cwkvq")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText4" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "Ano ang ma e tatabang ko saimo?"
voice = ExtResource("26_f8cb1")
npc_info = SubResource("Resource_i82gi")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText5" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "pwede bang bantayan mo ang daloy kan tubig, sa hiling ko padagos lang ini magang agos baka makaabot sa nayon."
npc_info = SubResource("Resource_it470")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText6" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "sige agama maaasahan mo ako."
voice = ExtResource("27_xvgsf")
npc_info = SubResource("Resource_5ihv0")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText7" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "napansin mo ba si enkanto?"
npc_info = SubResource("Resource_pf5oa")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText8" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
script = ExtResource("14_770yy")
text = "nahiling ko siya  jan lang sa may balyong sapa."
voice = ExtResource("28_on5ts")
npc_info = SubResource("Resource_5ihv0")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText9" type="Node" parent="Kanibag/DialogueInteraction2/ConversationIntro"]
