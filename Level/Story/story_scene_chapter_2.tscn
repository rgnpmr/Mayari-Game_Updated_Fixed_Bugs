[node name="StoryLines" type="Node" parent="CanvasLayer"]

[node name="DialogueText" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "Every day and every night, Agama guarded the mountain watching, waiting, never resting."
voice = ExtResource("3_njm0e")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText2" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "Not far from the mountain lived Kasili, a long and slippery eel who lived in the river winding through the forest."
voice = ExtResource("4_ju6ex")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText3" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "Unlike Agama, Kasili was playful and reckless, always moving, always disturbing the world around it."
voice = ExtResource("5_p4f2d")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText4" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "For many days, Agama stood watch without rest, until at last, the weight of it all became too much."
voice = ExtResource("6_n3ad0")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText5" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "The sun was hot. The wind was calm. Slowly, Agama's eyes grew heavy... and closed."
voice = ExtResource("7_6q55h")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText6" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "While Agama slept, Kasili slipped through the waters near the mountain, twisting and playing, never realizing the danger in its games."
voice = ExtResource("8_gijeu")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText7" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "The ground began to tremble. The river swelled. Something deep within the mountain stirred."
voice = ExtResource("9_1lyfu")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText8" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "\"Agama! Wake up! Kasili is disturbing the mountain please, you have to stop it!\" A voice of Engkanto"
voice = ExtResource("10_vkj3d")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText9" type="Node" parent="CanvasLayer/StoryLines"]
script = ExtResource("1_ib8mf")
text = "Agama's eyes snap open. The ground is already shaking beneath its feet. There is no more time to rest. It's time to climb the mountain, find Kasili, and set things right before it's too late."
voice = ExtResource("11_hby60")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

