[node name="StoryLines" type="Node" parent="."]

[node name="DialogueText" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "Long ago, near the foot of Mount Isarog, there lived a giant Agama. "
voice = ExtResource("8_sd4jn")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText2" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "The people in the village believed that this Agama was not an ordinary creature.  "
voice = ExtResource("9_n440o")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText3" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "It was known as the guardian of the mountain. "
voice = ExtResource("10_1ryaq")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText4" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "Mount Isarog stood, tall and powerful..."
voice = ExtResource("11_73fs1")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText5" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "The villager felt its strength because they believed that when the mountain became angry."
voice = ExtResource("12_pp5hl")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText6" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "It could shake the ground and release water, completely flooding the sorrounding environment. "
voice = ExtResource("13_1ryaq")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText7" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "But they also believed that as long as the Agama stayed strong and watchful..."
voice = ExtResource("13_vnx81")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText8" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "The mountain would remain calm and peaceful."
voice = ExtResource("14_1sj2o")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

[node name="DialogueText9" type="Node" parent="StoryLines"]
script = ExtResource("6_6f2ru")
text = "But peace does not last forever."
voice = ExtResource("15_h7ltm")
metadata/_custom_type_script = "uid://ueesf2ffbpr8"

